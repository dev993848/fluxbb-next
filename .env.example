APP_ENV=prod
APP_DEBUG=0

DB_DRIVER=pdo_pgsql
DB_HOST=database
DB_PORT=5432
DB_NAME=fluxbb
DB_USER=fluxbb
DB_PASSWORD=fluxbb_secret

# Cache: redis://redis:6379/1 (Docker), apcu://, file://
CACHE_DSN=redis://redis:6379/1
CACHE_NAMESPACE=fluxbb_

# Mailer: smtp://mailhog:1025 (Docker dev), smtp://user:pass@smtp.example.com:587 (prod)
MAILER_DSN=smtp://mailhog:1025
MAILER_FROM=noreply@fluxbb.local
MAILER_FROM_NAME=FluxBB Forum

# Redis (used for session storage + cache)
REDIS_HOST=redis
REDIS_PORT=6379

COOKIE_NAME=fluxbb_session
COOKIE_SEED=REPLACE-WITH-A-SECURE-64-CHAR-RANDOM-STRING-IN-PRODUCTION
DEFAULT_LANG=English
DEFAULT_STYLE=Air