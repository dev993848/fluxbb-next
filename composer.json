{
    "name": "fluxbb/fluxbb-next",
    "description": "FluxBB forum engine — modernized from v1.5.11 legacy",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "FluxBB Contributors",
            "homepage": "https://github.com/fluxbb/fluxbb"
        }
    ],
    "require": {
        "php": ">=8.2",
        "doctrine/dbal": "^4.0",
        "doctrine/migrations": "^3.7",
        "doctrine/orm": "^3.2",
        "nesbot/carbon": "^3.0",
        "php-di/php-di": "^7.0",
        "php-di/slim-bridge": "^3.4",
        "phpdocumentor/reflection-docblock": "^5.4",
        "predis/predis": "^3.6",
        "psalm/phar": "6.0.0",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0",
        "symfony/cache": "^7.0",
        "symfony/console": "^7.0",
        "symfony/event-dispatcher": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/mailer": "^8.1",
        "symfony/redis-messenger": "^8.0",
        "symfony/routing": "^7.0",
        "twig/twig": "^3.8",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.12",
        "phpstan/phpstan-strict-rules": "^1.6",
        "phpstan/extension-installer": "^1.4",
        "rector/rector": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.58",
        "symfony/var-dumper": "^7.0",
        "symfony/debug-bundle": "^7.0",
        "symfony/maker-bundle": "^1.58",
        "dama/doctrine-test-bundle": "^8.0",
        "laminas/laminas-development-mode": "^3.12"
    },
    "autoload": {
        "psr-4": {
            "FluxBB\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FluxBB\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:integration": "phpunit --testsuite integration",
        "phpstan": "phpstan analyse src --level=max",
        "phpstan:baseline": "phpstan analyse src --level=max --generate-baseline",
        "psalm": "psalm --no-cache",
        "psalm:init": "psalm --init",
        "psalm:baseline": "psalm --set-baseline=psalm-baseline.xml",
        "cs": "php-cs-fixer fix --dry-run",
        "cs:fix": "php-cs-fixer fix",
        "rector": "rector process src --dry-run",
        "rector:fix": "rector process src",
        "check": ["@cs", "@phpstan", "@psalm", "@rector"],
        "migrations:diff": "doctrine-migrations diff",
        "migrations:migrate": "doctrine-migrations migrate",
        "migrations:status": "doctrine-migrations status"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "extra": {
        "doctrine-migrations": {
            "migrations-path": "migrations",
            "table-storage": {
                "table_name": "doctrine_migration_versions",
                "version_column_name": "version",
                "version_column_length": 191
            },
            "organize-migrations": "year"
        }
    }
}
