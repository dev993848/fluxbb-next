{% extends 'base.html.twig' %}

{% block title %}{{ topic.subject }}{% endblock %}

{% block breadcrumbs_extra %}
    <svg class="separator" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
    </svg>
    <a href="/forum/{{ topic.forumId }}">Forum</a>
    <svg class="separator" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
    </svg>
    <span class="current">{{ topic.subject }}</span>
{% endblock %}

{% block body %}
    <div class="page-header animate-fade-in">
        <div class="flex items-center justify-between gap-4" style="flex-wrap: wrap;">
            <div>
                <h1>{{ topic.subject }}</h1>
                <div class="flex items-center gap-3 text-muted" style="flex-wrap: wrap;">
                    <span>Posted by <strong>{{ topic.poster }}</strong></span>
                    <span>•</span>
                    <span>{{ topic.postedAt|date('Y-m-d H:i') }}</span>
                    {% if topic.closed %}<span class="badge badge-warning">Closed</span>{% endif %}
                    {% if topic.sticky %}<span class="badge badge-info">Sticky</span>{% endif %}
                </div>
            </div>
        </div>
    </div>

    {% if posts is defined and posts is not empty %}
        <div class="card animate-fade-in-up">
            {% for post in posts %}
                <div class="post">
                    <div class="post-header">
                        <div class="post-author">
                            <div class="post-avatar">
                                {{ post.poster|first|upper }}
                            </div>
                            <div>
                                <div class="post-author-name">{{ post.poster }}</div>
                            </div>
                        </div>
                        <div class="post-date">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                            </svg>
                            {{ post.postedAt|date('Y-m-d H:i') }}
                        </div>
                    </div>

                    <div class="post-body">
                        {{ post.message|raw }}
                    </div>

                    <div class="post-actions">
                        {% if not topic.closed %}
                            <a href="/post/new?tid={{ topic.id }}" class="btn btn-sm btn-ghost">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                                </svg>
                                Reply
                            </a>
                        {% endif %}
                        <a href="/post/{{ post.id }}/edit" class="btn btn-sm btn-ghost">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                            Edit
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card animate-fade-in-up">
            <div class="empty-state">
                <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                <h3>No posts yet</h3>
                <p>This topic has no replies. Be the first to respond.</p>
            </div>
        </div>
    {% endif %}

    {% if not topic.closed %}
        <div class="flex justify-between items-center gap-4 mt-8 animate-fade-in-up">
            <a href="/post/new?tid={{ topic.id }}" class="btn btn-primary">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                </svg>
                Reply to this topic
            </a>
        </div>
    {% endif %}

    {# Pagination #}
    {% if total_pages is defined and total_pages > 1 %}
        <div class="pagination">
            {% if current_page > 1 %}
                <a href="?page={{ current_page - 1 }}">&laquo; Previous</a>
            {% endif %}
            {% for i in 1..total_pages %}
                <a href="?page={{ i }}" class="{{ i == current_page ? 'current' : '' }}">{{ i }}</a>
            {% endfor %}
            {% if current_page < total_pages %}
                <a href="?page={{ current_page + 1 }}">Next &raquo;</a>
            {% endif %}
        </div>
    {% endif %}
{% endblock %}