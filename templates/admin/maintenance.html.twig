{% extends 'base.html.twig' %}

{% block title %}Admin: Maintenance{% endblock %}

{% block breadcrumbs_extra %}
    <svg class="separator" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
    </svg>
    <a href="/admin">Admin</a>
    <svg class="separator" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"/>
    </svg>
    <span class="current">Maintenance</span>
{% endblock %}

{% block body %}
<div class="admin-layout">
    <aside class="admin-sidebar">
        {% include 'admin/_sidebar.html.twig' %}
    </aside>

    <div class="admin-content">
        <div class="page-header animate-fade-in">
            <h1>Maintenance</h1>
            <p>Tools to keep your forum running smoothly.</p>
        </div>

        {% if message %}
            <div class="alert alert-success">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
                <span>{{ message }}</span>
            </div>
        {% endif %}

        <div class="card-grid animate-stagger">
            <div class="card">
                <div class="card-body">
                    <h3>Rebuild Forum Statistics</h3>
                    <p>Recalculates topic and post counts for all forums.</p>
                </div>
                <div class="card-footer">
                    <form method="post" action="/admin/maintenance/rebuild-stats">
                        <input type="hidden" name="_csrf_token" value="{{ _csrf_token }}">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10"/>
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                            </svg>
                            Rebuild Stats
                        </button>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h3>Prune Old Topics</h3>
                    <p>Delete old topics that are not sticky or closed.</p>
                    <form method="post" action="/admin/maintenance/prune" style="margin-top: var(--space-4);">
                        <input type="hidden" name="_csrf_token" value="{{ _csrf_token }}">
                        <div class="form-inline">
                            <div class="form-group" style="margin-bottom: 0;">
                                <label class="form-label" for="days">Older than (days):</label>
                                <input type="number" id="days" name="days" class="form-input"
                                       value="30" min="1" style="width: 100px;">
                            </div>
                            <button type="submit" class="btn btn-danger"
                                    onclick="return confirm('This will permanently delete old topics. Continue?')">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                </svg>
                                Prune Topics
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card">
                <div class="card-body">
                    <h3>Rebuild Search Index</h3>
                    <p>Re-calculates full-text search vectors for all posts.</p>
                </div>
                <div class="card-footer">
                    <form method="post" action="/admin/maintenance/reindex">
                        <input type="hidden" name="_csrf_token" value="{{ _csrf_token }}">
                        <button type="submit" class="btn btn-primary">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="23 4 23 10 17 10"/>
                                <path d="M20.49 15a9 9 0 1 1-2.12-9.36L23 10"/>
                            </svg>
                            Rebuild Index
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}