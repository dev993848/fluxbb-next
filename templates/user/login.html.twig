{% extends 'base.html.twig' %}

{% block title %}Login{% endblock %}

{% block body %}
    <div class="page-header animate-fade-in">
        <h1>Welcome Back</h1>
        <p>Sign in with your account to continue.</p>
    </div>

    <div class="card animate-fade-in-up" style="max-width: 440px; margin: 0 auto;">
        <div class="card-body">
            {% if errors is defined and errors is not empty %}
                <div class="alert alert-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
                    </svg>
                    <span>{{ errors|first }}</span>
                </div>
            {% endif %}

            <form method="post" action="/login">
                <div class="form-group">
                    <label class="form-label" for="req_username">Username or Email</label>
                    <input type="text" id="req_username" name="req_username" class="form-input" required
                           placeholder="Enter your username or email">
                </div>

                <div class="form-group">
                    <label class="form-label" for="req_password">Password</label>
                    <input type="password" id="req_password" name="req_password" class="form-input" required
                           placeholder="Enter your password">
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Sign In
                </button>
            </form>

            <div class="mt-6 text-center">
                <a href="/register" class="text-muted">Don't have an account? Register</a>
                <span class="text-muted"> • </span>
                <a href="/forgot-password" class="text-muted">Forgot password?</a>
            </div>
        </div>
    </div>
{% endblock %}