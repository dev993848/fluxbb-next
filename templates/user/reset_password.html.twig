{% extends 'base.html.twig' %}

{% block title %}Reset Password{% endblock %}

{% block body %}
    <div class="page-header animate-fade-in">
        <h1>Reset Password</h1>
        <p>Choose a new password for your account.</p>
    </div>

    {% if errors is defined and errors is not empty %}
        <div class="alert alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <div>
                {% for error in errors %}
                    <p style="margin: 0;">{{ error }}</p>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="card animate-fade-in-up" style="max-width: 440px; margin: 0 auto;">
        <div class="card-body">
            <form method="post" action="/reset-password/{{ token }}">
                <input type="hidden" name="_csrf_token" value="{{ _csrf_token }}">
                <input type="hidden" name="token" value="{{ token }}">

                <div class="form-group">
                    <label class="form-label" for="req_password">New Password</label>
                    <input type="password" id="req_password" name="req_password" class="form-input" required
                           placeholder="At least 8 characters" minlength="8">
                </div>

                <div class="form-group">
                    <label class="form-label" for="req_password_confirm">Confirm Password</label>
                    <input type="password" id="req_password_confirm" name="req_password_confirm"
                           class="form-input" required placeholder="Repeat your password" minlength="8">
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                    Reset Password
                </button>
            </form>
        </div>
    </div>
{% endblock %}