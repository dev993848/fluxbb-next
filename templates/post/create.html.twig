{% extends 'base.html.twig' %}

{% block title %}{% if topic_id %}Reply{% else %}New Topic{% endif %} — FluxBB{% endblock %}

{% block body %}
    <div class="page-header animate-fade-in">
        <div class="flex items-center justify-between gap-4">
            <h1>{% if topic_id %}Reply to Topic{% else %}Start a New Discussion{% endif %}</h1>
        </div>
    </div>

    {% if errors is defined and errors is not empty %}
        <div class="alert alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <div>
                {% for error in errors %}
                    <p style="margin: 0;">{{ error }}</p>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="card animate-fade-in-up">
        <div class="card-body">
            <form method="post" action="/post/new">
                {% if topic_id == 0 %}
                    <div class="form-group">
                        <label class="form-label" for="req_subject">
                            Subject <span class="required">*</span>
                        </label>
                        <input type="text" id="req_subject" name="req_subject"
                               class="form-input" value="{{ subject|default('') }}"
                               maxlength="70" required placeholder="Enter a descriptive title">
                    </div>
                    <div class="form-group">
                        <label class="form-label" for="forum_id">Forum</label>
                        <select id="forum_id" name="forum_id" class="form-select">
                            {% if forums is defined %}
                                {% for forum in forums %}
                                    <option value="{{ forum.id }}" {{ forum.id == forum_id ? 'selected' : '' }}>
                                        {{ forum.name }}
                                    </option>
                                {% endfor %}
                            {% else %}
                                <option value="{{ forum_id }}">{{ forum_id }}</option>
                            {% endif %}
                        </select>
                    </div>
                {% endif %}

                <input type="hidden" name="topic_id" value="{{ topic_id }}">
                <input type="hidden" name="forum_id" value="{{ forum_id }}">

                <div class="form-group">
                    <label class="form-label" for="req_message">
                        Message <span class="required">*</span>
                    </label>
                    <textarea id="req_message" name="req_message"
                              class="form-textarea" rows="15" required
                              placeholder="Write your message here... BBCode is supported">{{ message|default('') }}</textarea>
                    <p class="form-hint">You can use BBCode tags: [b], [i], [url], [img], [code], etc.</p>
                </div>

                <div class="flex items-center gap-4 mt-6">
                    <button type="submit" name="form_sent" class="btn btn-primary btn-lg">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
                        </svg>
                        Submit
                    </button>
                    <a href="javascript:history.back()" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}