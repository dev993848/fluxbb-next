{% extends 'base.html.twig' %}

{% block title %}Edit Post — FluxBB{% endblock %}

{% block body %}
    <div class="page-header animate-fade-in">
        <h1>Edit Post</h1>
    </div>

    {% if errors is defined and errors is not empty %}
        <div class="alert alert-danger">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/>
            </svg>
            <div>
                {% for error in errors %}
                    <p style="margin: 0;">{{ error }}</p>
                {% endfor %}
            </div>
        </div>
    {% endif %}

    <div class="card animate-fade-in-up">
        <div class="card-body">
            <form method="post" action="/post/edit/{{ post.id }}">
                <div class="form-group">
                    <label class="form-label" for="req_message">Message</label>
                    <textarea id="req_message" name="req_message"
                              class="form-textarea" rows="15" required>{{ message|default('') }}</textarea>
                </div>

                <div class="flex items-center gap-4 mt-6">
                    <button type="submit" name="form_sent" class="btn btn-primary">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        Update
                    </button>
                    <a href="/topic/{{ post.topic_id|default(topic_id) }}" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
{% endblock %}